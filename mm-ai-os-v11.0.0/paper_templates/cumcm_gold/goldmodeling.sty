\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{goldmodeling}[2026/05/18 CUMCM paper standard v6.2]

% Page and spacing
\RequirePackage[a4paper,left=2.5cm,right=2.5cm,top=2.5cm,bottom=2.5cm]{geometry}
\RequirePackage{setspace}
\RequirePackage{indentfirst}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{caption}
\RequirePackage{graphicx}
\RequirePackage{subcaption}
\RequirePackage{booktabs}
\RequirePackage{longtable}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{multirow}
\RequirePackage{amsmath,amssymb,bm,mathtools}
\RequirePackage{siunitx}
\RequirePackage{algorithm}
\RequirePackage{algpseudocode}
\RequirePackage{enumitem}
\RequirePackage{xcolor}
\RequirePackage[most]{tcolorbox}
\RequirePackage{tikz}
\RequirePackage{pgfplots}
\RequirePackage{listings}
\RequirePackage{float}
\RequirePackage{placeins}
\RequirePackage{makecell}
\RequirePackage[colorlinks=true,linkcolor=black,citecolor=black,urlcolor=black]{hyperref}
\RequirePackage[nameinlink,noabbrev]{cleveref}
\RequirePackage[backend=biber,style=gb7714-2015,sorting=none]{biblatex}
\pgfplotsset{compat=1.18}

% Float placement policy: avoid large blank areas caused by forced [H] figures.
\raggedbottom
\setcounter{topnumber}{5}
\setcounter{bottomnumber}{5}
\setcounter{totalnumber}{8}
\renewcommand{\topfraction}{0.92}
\renewcommand{\bottomfraction}{0.85}
\renewcommand{\textfraction}{0.06}
\renewcommand{\floatpagefraction}{0.72}
\setlength{\textfloatsep}{8pt plus 2pt minus 2pt}
\setlength{\floatsep}{8pt plus 2pt minus 2pt}
\setlength{\intextsep}{8pt plus 2pt minus 2pt}

% CUMCM-like global typography
\linespread{1.25}
\setlength{\parindent}{2em}
\setlength{\parskip}{0pt}
\setlength{\headheight}{14pt}

% No running header by default; page number centered at footer.
\pagestyle{fancy}
\fancyhf{}
\fancyfoot[C]{\zihao{-5}\thepage}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

% Section numbering: Chinese major sections, Arabic subsections.
\renewcommand{\thesection}{\chinese{section}}
\renewcommand{\thesubsection}{\arabic{section}.\arabic{subsection}}
\renewcommand{\thesubsubsection}{\arabic{section}.\arabic{subsection}.\arabic{subsubsection}}

% Major section headings: centered, bold, black font.
\titleformat{\section}
  {\centering\heiti\zihao{3}\bfseries}
  {\thesection、}
  {0pt}
  {}
\titleformat{name=\section,numberless}
  {\centering\heiti\zihao{3}\bfseries}
  {}
  {0pt}
  {}
\titleformat{\subsection}
  {\heiti\zihao{4}\bfseries}
  {\thesubsection}
  {0.8em}
  {}
\titleformat{\subsubsection}
  {\heiti\zihao{-4}\bfseries}
  {\thesubsubsection}
  {0.8em}
  {}
\titlespacing*{\section}{0pt}{1.6em}{1.0em}
\titlespacing*{\subsection}{0pt}{1.0em}{0.55em}
\titlespacing*{\subsubsection}{0pt}{0.8em}{0.35em}

% Abstract and keyword helpers
\newcommand{\papertitle}[1]{%
  \begin{center}
    {\heiti\zihao{-2}\bfseries #1\par}
  \end{center}
  \vspace{1.0em}
}
\newenvironment{cumcmabstract}{%
  \begin{center}{\heiti\zihao{3}\bfseries 摘\quad 要}\end{center}
  \vspace{0.2em}\zihao{-4}\songti
}{\par}
\newcommand{\keywords}[1]{%
  \par\vspace{0.6em}\noindent{\heiti\bfseries 关键词：}#1\par
}
\newcommand{\keytext}[1]{\textbf{#1}}
\newcommand{\abstractemph}[1]{\textbf{#1}}

% Captions: figure below, table above by authoring convention.
\captionsetup{font=small,labelfont=bf,labelsep=space,justification=centering}
\captionsetup[figure]{name=图,position=bottom}
\captionsetup[table]{name=表,position=top}
\renewcommand{\figurename}{图}
\renewcommand{\tablename}{表}
\renewcommand{\algorithmicrequire}{\textbf{输入：}}
\renewcommand{\algorithmicensure}{\textbf{输出：}}
\floatname{algorithm}{算法}

% Lists and tables
\setlist[itemize]{leftmargin=2em,itemsep=0.2em,topsep=0.2em}
\setlist[enumerate]{leftmargin=2.4em,itemsep=0.2em,topsep=0.2em}
\newcolumntype{Y}{>{\centering\arraybackslash}X}
\newcolumntype{L}{>{\raggedright\arraybackslash}X}

% Result box: restrained contest-paper style.
\newtcolorbox{resultbox}[1][]{
  colback=gray!4,
  colframe=black!55,
  fonttitle=\heiti\bfseries,
  boxrule=0.55pt,
  arc=1mm,
  left=1.6mm,
  right=1.6mm,
  top=1.0mm,
  bottom=1.0mm,
  title=#1
}
\newcommand{\keyresult}[2]{%
\begin{resultbox}[#1]
#2
\end{resultbox}
}

% Math shortcuts
\newcommand{\sectionlead}[1]{\noindent\textbf{#1}\quad}
\newcommand{\diff}{\mathop{}\!\mathrm{d}}
\newcommand{\E}{\mathbb{E}}
\newcommand{\Var}{\mathrm{Var}}
\newcommand{\R}{\mathbb{R}}
\newcommand{\argmin}{\mathop{\mathrm{arg\,min}}}
\newcommand{\argmax}{\mathop{\mathrm{arg\,max}}}

% Code appendix style
\lstdefinestyle{modelcode}{
  basicstyle=\ttfamily\zihao{6},
  numbers=left,
  numberstyle=\tiny,
  frame=single,
  breaklines=true,
  columns=fullflexible,
  tabsize=2,
  showstringspaces=false,
  aboveskip=0.4em,
  belowskip=0.4em
}
\renewcommand{\lstlistingname}{代码}
\lstset{style=modelcode}

% Cross-reference names
\crefname{equation}{式}{式}
\Crefname{equation}{式}{式}
\crefname{figure}{图}{图}
\Crefname{figure}{图}{图}
\crefname{table}{表}{表}
\Crefname{table}{表}{表}
\crefname{algorithm}{算法}{算法}
\Crefname{algorithm}{算法}{算法}

% SI unit setup
\sisetup{per-mode=symbol,detect-all=true}


% Page-level structural commands for CUMCM papers.
\newcommand{\referencespage}{\clearpage\section*{参考文献}}
\newcommand{\appendixpage}{\clearpage\section*{附录}}


% CUMCM front-stage section helpers.
\newcommand{\analysischecksection}{\section{模型的分析与检验}}
\newcommand{\evaluationsection}{\section{模型的评价与推广}}
