{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "gate",
    "status",
    "failures"
  ],
  "properties": {
    "gate": {
      "type": "string"
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "warning"
      ]
    },
    "failures": {
      "type": "array"
    }
  }
}