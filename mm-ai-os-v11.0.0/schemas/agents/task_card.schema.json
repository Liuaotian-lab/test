{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentTaskCard",
  "type": "object",
  "required": [
    "task_id"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "question_id": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "phase": {
      "type": "string"
    },
    "allowed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
