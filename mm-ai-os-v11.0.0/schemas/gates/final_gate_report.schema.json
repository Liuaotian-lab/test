{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FinalGateReport",
  "type": "object",
  "required": [
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "gate": {
      "type": "string"
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "warning"
      ]
    },
    "final_allowed": {
      "type": "boolean"
    },
    "blocking_issues": {
      "type": "array"
    },
    "warnings": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
