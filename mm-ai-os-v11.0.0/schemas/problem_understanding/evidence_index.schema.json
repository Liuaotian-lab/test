{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidenceIndex",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "question_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "timestamp": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "evidence_span.schema.json"
      }
    },
    "evidence_count": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": true
}
