{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mm-ai-os.local/schemas/solver/constraint_test_report.schema.json",
  "title": "Constraint Test Report",
  "type": "object",
  "required": ["gate", "status", "failures", "warnings", "questions"],
  "properties": {
    "gate": {"const": "constraint-test"},
    "status": {"enum": ["passed", "warning", "failed"]},
    "failures": {"type": "array"},
    "warnings": {"type": "array"},
    "questions": {"type": "array"}
  },
  "additionalProperties": true
}
