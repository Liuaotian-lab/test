{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mm-ai-os.local/schemas/solver/solution_real.schema.json",
  "title": "MM-AI OS Real Solver Solution",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "question_id",
    "scope",
    "data_source",
    "experiment_id",
    "model",
    "method",
    "quality_level",
    "solver_status",
    "optimal",
    "metrics",
    "violation_count",
    "diagnostics",
    "artifacts",
    "limitations"
  ],
  "properties": {
    "question_id": {"type": "string", "minLength": 1},
    "scope": {"enum": ["real", "reduced", "demo", "exploratory"]},
    "data_source": {
      "enum": [
        "real_attachment_data",
        "problem_statement_derived",
        "official_template",
        "synthetic_fixture",
        "demo_data"
      ]
    },
    "experiment_id": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "method": {"type": "string", "minLength": 1},
    "quality_level": {
      "enum": [
        "global_optimal",
        "certified_optimal",
        "exhaustive_best",
        "local_optimal",
        "heuristic_feasible",
        "evaluated_best",
        "simulation_estimate",
        "approximate",
        "exploratory",
        "failed"
      ]
    },
    "solver_status": {
      "enum": [
        "completed",
        "completed_with_warnings",
        "failed",
        "timeout",
        "iter_limit",
        "fallback"
      ]
    },
    "optimal": {"type": "boolean"},
    "metrics": {"type": "object"},
    "violation_count": {"type": "integer", "minimum": 0},
    "diagnostics": {
      "type": "object",
      "required": ["constraints_checked", "domain_validators_run", "fallback_used"],
      "properties": {
        "constraints_checked": {"type": "boolean"},
        "domain_validators_run": {"type": "array", "items": {"type": "string"}},
        "fallback_used": {"type": "boolean"}
      }
    },
    "artifacts": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "limitations": {"type": "string", "minLength": 1}
  }
}
