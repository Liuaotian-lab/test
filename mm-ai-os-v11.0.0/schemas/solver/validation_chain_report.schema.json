{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mm-ai-os.local/schemas/solver/validation_chain_report.schema.json",
  "title": "Validation Chain Report",
  "type": "object",
  "required": ["gate", "status", "failures", "warnings"],
  "properties": {
    "gate": {"type": "string"},
    "status": {"enum": ["passed", "warning", "failed"]},
    "failures": {"type": "array"},
