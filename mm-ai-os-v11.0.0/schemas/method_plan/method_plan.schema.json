        },
        "primary_model": {
          "type": [
            "object",
            "null"
          ]
        },
        "alternative_models": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "optimization_method": {
          "type": [
            "object",
            "null"
          ]
        },
        "verification_approach": {
          "type": [
            "object",
            "null"
          ]
        },
        "literature_references": {
          "type": "array",
          "items": {
