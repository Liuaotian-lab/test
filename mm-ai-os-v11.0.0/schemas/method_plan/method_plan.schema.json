                }
              },
              "optimization_method": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "verification_approach": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "literature_references": {
                "type": "array",
                "items": {
                  "$ref": "../academic_research/citation.schema.json"
                }
              },
              "citation_count": {
                "type": "integer",
