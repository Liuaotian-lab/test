{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "experiment_id",
    "question_id",
    "model",
    "method",
    "quality_level",
    "solver_status",
    "scope",
    "data_source",
    "metrics",
    "conclusion",
    "limitations",
    "artifacts",
    "validators",
    "violation_count",
    "created_at"
  ],
  "properties": {
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "question_id": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "quality_level": {
      "enum": [
        "global_optimal",
        "certified_optimal",
        "exhaustive_best",
        "local_optimal",
        "heuristic_feasible",
        "evaluated_best",
        "simulation_estimate",
        "approximate",
        "exploratory",
        "failed"
      ]
    },
    "solver_status": {
      "enum": [
        "completed",
        "completed_with_warnings",
        "failed",
        "timeout",
        "iter_limit",
        "fallback"
      ]
    },
    "scope": {
      "enum": [
        "real",
        "reduced",
        "demo",
        "exploratory"
      ]
    },
    "data_source": {
      "enum": [
        "real_attachment_data",
        "problem_statement_derived",
        "official_template",
        "synthetic_fixture",
        "demo_data"
      ]
    },
    "parameters": {
      "type": "object"
    },
    "metrics": {
      "type": "object"
    },
    "conclusion": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validators": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "violation_count": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "type": "string"
    },
    "input_hashes": {
      "type": "object"
    },
    "output_hashes": {
      "type": "object"
    }
  }
}
