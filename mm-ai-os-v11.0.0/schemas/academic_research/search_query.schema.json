{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SearchQuery",
  "type": "object",
  "required": [
    "query_id",
    "query",
    "purpose"
  ],
  "properties": {
    "query_id": {
      "type": "string"
    },
    "query": {
      "type": "string",
      "minLength": 2
    },
    "purpose": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "priority": {
      "type": "number"
    },
    "required": {
      "type": "boolean"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "additionalProperties": true
}
