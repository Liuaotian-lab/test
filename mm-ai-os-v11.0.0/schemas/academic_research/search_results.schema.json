{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AcademicSearchResults",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "searches"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "searches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "question_id",
          "queries"
        ],
        "properties": {
          "question_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "queries": {
            "type": "array",
            "items": {
              "$ref": "search_query.schema.json"
            }
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "search_result.schema.json"
            }
          },
          "total_queries": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": true
      }
    },
    "agent_execution_contract": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
