{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IdentifiedMethod",
  "type": "object",
  "required": [
    "method_name",
    "role"
  ],
  "properties": {
    "method_name": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "evidence_span": {
      "type": "string"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "relevance_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source_title": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "source_snippet": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
